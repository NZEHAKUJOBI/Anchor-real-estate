# Copy to .env.local for local development. Never commit the real values.

# ── Database ────────────────────────────────────────────────────────
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anchor?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/anchor   (see: npm run mongo:dev)
# URL-encode the password if it contains @ : / ? # [ ] or %.
MONGODB_URI=

# ── Sessions ────────────────────────────────────────────────────────
# Signs the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -base64 32
# Changing this signs every administrator out immediately.
SESSION_SECRET=

# ── Outbound mail ───────────────────────────────────────────────────
# You can use Resend (recommended) or SMTP.
#
# Option A: Resend (HTTP API)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_123456789abcdef012345678
# Optional: secret for verifying inbound email webhook (/api/mail/inbound)
INBOUND_MAIL_SECRET=
#
# Option B: SMTP
# Render blocks outbound port 25 — use 587 (STARTTLS) or 465 (implicit TLS).
# Gmail: SMTP_USER is the full address and SMTP_PASS must be a 16-character
# Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: force TLS mode. Defaults to true only on port 465.
# SMTP_SECURE=false

# The From address on outgoing mail.
# While verifying your domain on Resend, you can use: "Anchor Real Estate Group <onboarding@resend.dev>"
# Once verified: "Anchor Real Estate Group <secretariat@anchorrealestategroup.ng>"
MAIL_FROM="Anchor Real Estate Group <onboarding@resend.dev>"

# Where new-enquiry notifications go. Defaults to MAIL_FROM if blank.
SECRETARIAT_EMAIL=secretariat@anchorrealestategroup.ng

# ── Links in emails ─────────────────────────────────────────────────
# Absolute base URL, used to build the "review in the Secretariat" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auto-seed credentials ──────────────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@anchorrealestategroup.ng
SEED_ADMIN_PASSWORD=123456789
SEED_ADMIN_ROLE=admin

